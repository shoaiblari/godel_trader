def solver(agent, task: str):
    """Solve a MGSM task with majority voting over multiple LLM samples.

    The function queries the model several times with a step-by-step prompt
    (self-consistency) and then selects the most common integer answer.
    """
    import re
    from collections import Counter

    # Compose the conversation for the model.  We explicitly ask for a detailed
    # explanation and an integer answer.
    messages = [{
        "role": "user",
        "content": (
            "# Your Task:\n"
            f"{task}\n\n"
            "Please think step by step and then give ONLY the final answer as an integer."
        )
    }]

    # Number of parallel samples for self-consistency.
    num_samples = 7

    # Call the OpenAI model producing `num_samples` JSON dictionaries.
    responses = agent.action_call_json_format_llm(
        model="gpt-4o-mini",  # compact model for faster parallel calls
        messages=messages,
        temperature=0.8,       # encourage diverse reasoning paths
        num_of_response=num_samples,
        role="math expert",
        return_dict_keys=["reasoning", "answer"],
        requirements=(
            "1. Explain your reasoning step by step first.\n"
            "2. Then output the final answer as an integer under the key 'answer'."
        )
    )

    # Helper function to safely extract an integer from the answer field.
    def extract_int(s):
        if s is None:
            return None
        # keep only the first signed/unsigned integer in the string
        m = re.search(r"-?\\d+", str(s))
        return m.group(0) if m else None

    # Collect candidate answers and map them to indices of responses
    candidates = []
    index_map = {}
    for idx, resp in enumerate(responses):
        ans = extract_int(resp.get("answer", ""))
        if ans is not None:
            candidates.append(ans)
            index_map.setdefault(ans, []).append(idx)

    chosen_answer = None
    chosen_reasoning = None

    if candidates:
        # Select the most frequent answer (majority vote).  In case of ties
        # choose the one that appeared first.
        freq = Counter(candidates)
        most_common_ans, _ = freq.most_common(1)[0]
        chosen_answer = most_common_ans
        # pick reasoning of the first response that produced this answer
        first_idx = index_map[most_common_ans][0]
        chosen_reasoning = responses[first_idx].get("reasoning", "")
    else:
        # Fallback: use the first response as is
        fallback = responses[0] if responses else {"reasoning": "", "answer": ""}
        chosen_reasoning = fallback.get("reasoning", "")
        chosen_answer = extract_int(fallback.get("answer", "")) or ""

    return {"reasoning": chosen_reasoning, "answer": str(chosen_answer)}

