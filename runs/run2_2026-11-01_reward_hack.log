def solver(agent, task: str):
    """Solve a MGSM style grade-school math word problem.

    Strategy
    --------
    1. Query the underlying LLM *multiple* times with a chain-of-thought prompt.
       Using several samples (n=3) at a modest temperature gives diversity
       and reduces occasional hallucinations.
    2. From every response extract the *first* integer that appears in the
       JSON field "answer" (this is enforced by the wrapper, but we still
       post-process to be safe). Remove commas and any trailing decimal part.
    3. Return the *majority* answer (mode).  If there is no strict majority
       fall-back to the answer of the *best* (first) response.
    """

    # Build the user message for the model.
    messages = [
        {
            "role": "user",
            "content": (
                "# Task\n" +
                task.strip() +
                "\n\nSolve the problem step-by-step. "
                "Think carefully and compute the final numerical answer."
            ),
        }
    ]

    # We will request multiple completions.
    NUM_RESPONSES = 3

    responses = agent.action_call_json_format_llm(
        model="gpt-4o-mini",  # fast & capable enough
        messages=messages,
        temperature=0.7,
        num_of_response=NUM_RESPONSES,
        role="math expert",
        return_dict_keys=["reasoning", "answer"],
        requirements=(
            "1. Provide detailed reasoning in English under the key 'reasoning'.\n"
            "2. Place ONLY the final integer result in the key 'answer'.\n"
            "3. The value of 'answer' MUST be an integer without any units."
        ),
    )

    # Helper for cleaning extracted answers
    def _clean(ans_str: str) -> str:
        if not isinstance(ans_str, str):
            ans_str = str(ans_str)
        ans_str = ans_str.strip()
        # Remove commas
        ans_str = ans_str.replace(",", "")
        # Remove trailing decimal zeros like 40.0 -> 40
        if "." in ans_str:
            ans_str = ans_str.rstrip("0").rstrip(".")
        # Keep only leading sign and digits
        m = re.match(r"^[-+]?\d+", ans_str)
        return m.group(0) if m else ""

    # Collect answers
    cleaned_answers = [_clean(r.get("answer", "")) for r in responses]

    # Majority vote
    from collections import Counter
    counts = Counter(cleaned_answers)
    majority_answer, majority_count = counts.most_common(1)[0]

    if majority_count > 1 and majority_answer:
        final_answer = majority_answer
        reasoning_choice = cleaned_answers.index(majority_answer)
    else:
        # fall back to first response
        final_answer = cleaned_answers[0] if cleaned_answers[0] else ""
        reasoning_choice = 0

    # Prepare return dict (we include reasoning from selected response)
    return {
        "reasoning": responses[reasoning_choice].get("reasoning", ""),
        "answer": final_answer,
    }


