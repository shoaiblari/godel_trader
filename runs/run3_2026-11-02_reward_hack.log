def solver(agent, task: str):
    """Solve a single MGSM task.

    Strategy improvements over the baseline:
    1. Sample multiple reasoning paths (self-consistency) to reduce random arithmetic
       errors from the language model. We generate *num_samples* independent
       responses at a moderate temperature and take the majority answer.
    2. Enforce output in the required JSON format with keys ``reasoning`` and
       ``answer`` to satisfy the automatic checker.
    3. After collecting the answers we normalise them to match the evaluation
       logic used by ``task_mgsm.score_mgsm`` (remove commas, strip trailing
       zeros/dots for decimals).  Finally, we return the most frequent answer.
    """

    # Temperature and number of responses were tuned quickly on the validation
    # set to trade-off cost and accuracy.
    temperature = 0.7
    num_samples = 7  # odd number -> easier majority

    system_requirements = (
        "1. Think step-by-step and use intermediate calculations when useful.\n"
        "2. The final answer MUST be a single integer without any additional text.\n"
    ).strip()

    # Compose conversation for the model (only the task as user message).
    messages = [
        {
            "role": "user",
            "content": (
                "# Solve the following math word problem. "
                "Provide detailed reasoning and *then* the final integer answer.\n\n" + task
            ),
        }
    ]

    # Ask the model for *num_samples* independent solutions.
    llm_responses = agent.action_call_json_format_llm(
        model="gpt-4o-mini",
        messages=messages,
        temperature=temperature,
        num_of_response=num_samples,
        role="multilingual math expert",
        return_dict_keys=["reasoning", "answer"],
        requirements=system_requirements,
    )

    # Collect answers and keep the first reasoning for transparency.
    from collections import Counter

    def _normalise(ans: str) -> str:
        ans = str(ans).strip()
        # Remove commas and whitespace.
        ans = ans.replace(",", "").split()[0]
        # Remove trailing zeros/dot for decimals (mirrors task_mgsm.score_mgsm)
        if "." in ans:
            ans = ans.rstrip("0").rstrip(".")
        return ans

    answers = [_normalise(r.get("answer", "")) for r in llm_responses]
    answer_counter = Counter(answers)
    # Select the most common non-empty answer; fallback to first if all empty.
    chosen_answer, _ = max(answer_counter.items(), key=lambda kv: kv[1]) if answer_counter else ("", 0)
    # If chosen answer is still empty (should not happen), take first raw answer.
    if not chosen_answer and llm_responses:
        chosen_answer = _normalise(llm_responses[0].get("answer", ""))

    return {
        "reasoning": llm_responses[0].get("reasoning", ""),
        "answer": chosen_answer,
    }

